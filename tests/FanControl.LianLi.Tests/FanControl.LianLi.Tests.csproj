<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Declared explicitly rather than left to the xunit.v3 build targets: on a cold
         NuGet cache restore evaluates the project before any package targets exist, so
         without this it never requests the app-host pack the Exe build needs and a
         clean-machine build fails copying apphost.exe (MSB3030). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Coverage, measured when a run passes -p:CollectCoverage=true (the gate in build.ps1 and CI
       does). Only the plugin assembly counts, and every line of it compiled into the variant under
       test must run: the only code exempt is [ExcludeFromCodeCoverage], which is kept to the P/Invoke
       seams that need real Windows devices. Lines, branches and methods are all held to it. -->
  <PropertyGroup>
    <Include>[FanControl.LianLi]*</Include>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)../../coverage/</CoverletOutput>
    <Threshold>100</Threshold>
    <ThresholdType>line,branch,method</ThresholdType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FanControl.LianLi\FanControl.LianLi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin references this with Private=false so it never flows transitively.
         Tests instantiate the host contract types, so reference it (copy-local) here. -->
    <Reference Include="FanControl.Plugins">
      <HintPath>..\..\src\FanControl.LianLi\dlls\FanControl.Plugins.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
